# Copy to .env for local dev. NEVER commit a real .env file.

NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://vastraa:vastraa@localhost:5432/vastraa_dev

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# true in staging/production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

MEDIA_DIR=./uploads
MEDIA_PUBLIC_URL=/media
MAX_UPLOAD_MB=8

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Used only by `npm run seed` — not read by the app itself
SEED_ADMIN_PASSWORD=ChangeMe123!
