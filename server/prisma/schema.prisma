// Vastraa Wholesale — Prisma schema
// Mirrors src/types/index.ts on the frontend. Single-business deployment
// (not multi-tenant SaaS): "tenant isolation" here means customer-scoped
// catalogue/enquiry access, not cross-business isolation. See ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  staff
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(staff)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  inventoryEntries InventoryEntry[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id        String   @id @default("business")
  name      String
  tagline   String
  type      String
  phone     String
  whatsapp  String
  email     String
  address   String
  city      String
  state     String
  updatedAt DateTime @updatedAt

  @@map("business")
}

model AppSettings {
  id                String   @id @default("settings")
  showPrice         Boolean  @default(true)
  showStock         Boolean  @default(true)
  defaultExpiry     String   @default("7d")
  defaultMOQ        Int      @default(1)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt

  @@map("app_settings")
}

enum CategoryStatus {
  active
  inactive
}

model Category {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  imageUrl     String?
  status       CategoryStatus @default(active)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attributes CategoryAttribute[]
  products   Product[]

  @@map("categories")
}

enum AttributeType {
  color
  text
  size
}

model Attribute {
  id        String        @id @default(cuid())
  name      String
  type      AttributeType
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  values     AttributeValue[]
  categories CategoryAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  hex         String?

  @@index([attributeId])
  @@map("attribute_values")
}

model CategoryAttribute {
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@map("category_attributes")
}

enum ProductStatus {
  active
  draft
  archived
}

model Product {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  description    String        @default("")
  wholesalePrice Decimal       @db.Decimal(12, 2)
  comparePrice   Decimal?      @db.Decimal(12, 2)
  moq            Int           @default(1)
  status         ProductStatus @default(draft)
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  media           ProductMedia[]
  variants        ProductVariant[]
  collectionItems CollectionProduct[]
  catalogueItems  CatalogueItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_media")
}

enum VariantStatus {
  active
  inactive
}

model ProductVariant {
  id                String        @id @default(cuid())
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String        @unique
  attributes        Json
  price             Decimal       @db.Decimal(12, 2)
  comparePrice      Decimal?      @db.Decimal(12, 2)
  stock             Int           @default(0)
  reserved          Int           @default(0)
  status            VariantStatus @default(active)
  lowStockThreshold Int           @default(10)
  /// optimistic-concurrency guard for stock mutations
  version           Int           @default(0)

  inventoryEntries InventoryEntry[]
  enquiryItems     EnquiryItem[]

  @@index([productId])
  @@map("product_variants")
}

enum InventoryChangeType {
  add
  remove
  set
}

enum InventoryReason {
  New_Production
  Customer_Order
  Damage
  Correction
  Return
}

model InventoryEntry {
  id            String               @id @default(cuid())
  variantId     String
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId     String
  type          InventoryChangeType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        InventoryReason
  note          String?
  createdAt     DateTime             @default(now())
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])

  @@index([variantId])
  @@index([createdAt])
  @@map("inventory_entries")
}

enum CustomerType {
  Wholesaler
  Retailer
  Distributor
  Reseller
}

enum CustomerStatus {
  active
  inactive
}

model Customer {
  id             String         @id @default(cuid())
  businessName   String
  contactPerson  String
  phone          String
  whatsapp       String
  email          String?
  city           String
  state          String
  type           CustomerType
  gstNumber      String?
  notes          String?
  status         CustomerStatus @default(active)
  createdAt      DateTime       @default(now())
  lastActivityAt DateTime?

  activities CustomerActivity[]
  catalogues Catalogue[]
  enquiries  Enquiry[]

  @@map("customers")
}

enum CustomerActivityType {
  viewed_catalogue
  viewed_product
  selected_products
  submitted_enquiry
  catalogue_sent
}

model CustomerActivity {
  id         String               @id @default(cuid())
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       CustomerActivityType
  title      String
  detail     String?
  link       String?
  createdAt  DateTime             @default(now())

  @@index([customerId])
  @@map("customer_activities")
}

enum CollectionStatus {
  active
  draft
  archived
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String            @default("")
  coverImage  String?
  status      CollectionStatus  @default(draft)
  createdAt   DateTime          @default(now())

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

enum CatalogueStatus {
  active
  expired
  draft
  disabled
}

enum PriceAdjustmentType {
  none
  percentage
  custom
}

enum CatalogueExpiry {
  d1
  d7
  d30
  never
}

model Catalogue {
  id         String          @id @default(cuid())
  slug       String          @unique
  name       String
  message    String?
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  status     CatalogueStatus @default(draft)
  views      Int             @default(0)
  createdAt  DateTime        @default(now())
  expiresAt  DateTime?

  // settings (flattened; matches CatalogueSettings)
  showWholesalePrice  Boolean             @default(true)
  showExactStock      Boolean             @default(true)
  showAvailability    Boolean             @default(true)
  showMOQ             Boolean             @default(true)
  allowProductSelection Boolean           @default(true)
  allowEnquiry        Boolean             @default(true)
  allowImageDownload  Boolean             @default(false)
  priceAdjustmentType PriceAdjustmentType @default(none)
  priceAdjustmentValue Decimal            @default(0) @db.Decimal(12, 2)
  pinProtected        Boolean             @default(false)
  /// bcrypt hash of the PIN, never the raw PIN
  pinHash             String?
  expiry              CatalogueExpiry     @default(d7)

  items    CatalogueItem[]
  visits   CatalogueVisit[]
  enquiries Enquiry[]

  @@index([customerId])
  @@index([status])
  @@map("catalogues")
}

model CatalogueItem {
  id            String    @id @default(cuid())
  catalogueId   String
  catalogue     Catalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// { attributeKey: string[] } — empty/absent = all values allowed
  variantFilter Json      @default("{}")
  allVariants   Boolean   @default(true)

  @@unique([catalogueId, productId])
  @@map("catalogue_items")
}

model CatalogueVisit {
  id                String    @id @default(cuid())
  catalogueId       String
  catalogue         Catalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  visitedAt         DateTime  @default(now())
  productIdsViewed  Json      @default("[]")
  /// hashed visitor fingerprint (ip+ua), used only for unique-visitor counting
  visitorHash       String?

  @@index([catalogueId])
  @@map("catalogue_visits")
}

enum EnquiryStatus {
  New
  Contacted
  Negotiating
  Converted
  Closed
}

model Enquiry {
  id             String        @id @default(cuid())
  refNumber      String        @unique
  catalogueId    String
  catalogue      Catalogue     @relation(fields: [catalogueId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  businessName   String
  contactName    String
  phone          String
  whatsapp       String
  message        String?
  estimatedValue Decimal       @db.Decimal(12, 2)
  status         EnquiryStatus @default(New)
  createdAt      DateTime      @default(now())

  items    EnquiryItem[]
  timeline EnquiryTimelineEntry[]

  @@index([catalogueId])
  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id             String         @id @default(cuid())
  enquiryId      String
  enquiry        Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  priceAtEnquiry Decimal        @db.Decimal(12, 2)

  @@index([enquiryId])
  @@map("enquiry_items")
}

model EnquiryTimelineEntry {
  id        String        @id @default(cuid())
  enquiryId String
  enquiry   Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  status    EnquiryStatus
  note      String?
  at        DateTime      @default(now())

  @@index([enquiryId])
  @@map("enquiry_timeline")
}

enum NotificationType {
  enquiry
  low_stock
  catalogue_view
  catalogue_milestone
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([read])
  @@map("notifications")
}
