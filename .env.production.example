# Copy to .env.production on the server and fill in. NEVER commit .env.production.
# Placeholders only. Generate secrets with:  openssl rand -base64 36
# Use:  docker compose --env-file .env.production ...

# Public hostname: a real domain, or vastraa.<NEW-VPS-IP>.sslip.io. CORS_ORIGIN is derived (https://APP_HOST).
APP_HOST=vastraa.example.com

# PostgreSQL (the only required persistent volume). Prefer a URL-safe password: openssl rand -hex 24
POSTGRES_USER=vastraa
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vastraa

SESSION_DAYS=7
UPLOAD_MAX_BYTES=5242880

# Media storage: Cloudflare R2 in production.
UPLOAD_PROVIDER=r2
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
# Public read URL of the bucket, no trailing slash, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=https://media.example.com
# Optional; derived from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=

# Traefik mode only (docker-compose.yml). Not used by docker-compose.standalone.yml.
TRAEFIK_NETWORK=traefik
CERT_RESOLVER=letsencrypt
