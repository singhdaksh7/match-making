NODE_ENV=development
DATABASE_URL="postgresql://vastraa:change-me@localhost:5432/vastraa?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173
SESSION_DAYS=7
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
# S3-compatible production provider configuration (adapter/credentials required before enabling)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Docker/Traefik deployment placeholders
POSTGRES_USER=vastraa
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vastraa
APP_HOST=vastraa.example.com
TRAEFIK_NETWORK=replace-with-existing-traefik-network
CERT_RESOLVER=letsencrypt
