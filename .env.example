# Local development defaults. Copy to .env (never commit). For production use
# .env.production.example -> .env.production on the server.
NODE_ENV=development
DATABASE_URL="postgresql://vastraa:change-me@localhost:5432/vastraa?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173
SESSION_DAYS=7
# Media: "local" for dev/test (files under UPLOAD_DIR); production uses "r2".
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
# Cloudflare R2 (only when UPLOAD_PROVIDER=r2). Use a separate dev bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional; derived from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=
